{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xhist",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "routes": [{ "pattern": "xhist.hwmnbn.me", "custom_domain": true }],

  // The page and its assets. /api and /auth always reach the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Sessions (sess:), OAuth state (oauth:), lookup results (detail:) and
  // memory.lol / Wayback responses (src:).
  "kv_namespaces": [{ "binding": "XHIST_KV", "id": "01a281dcaaee4f1e8d1dae29f57c2291" }],

  // 20 lookups per minute per IP.
  "ratelimits": [
    { "name": "LOOKUP_LIMITER", "namespace_id": "4801", "simple": { "limit": 20, "period": 60 } },
    // 2 detailed lookups per minute per X account: bounds bursts that the
    // KV daily counter (no atomic increment) can't see.
    { "name": "DETAILED_LIMITER", "namespace_id": "4802", "simple": { "limit": 2, "period": 60 } }
  ],

  "vars": {
    // Client ID of the X app (developer.x.com) registered as a "Native App",
    // callback https://xhist.hwmnbn.me/auth/callback. Public by design: it is
    // part of every sign-in URL. Empty = sign-in off, basic lookups only.
    "X_CLIENT_ID": "",
    // Who may run detailed lookups: comma-separated X account IDs (stable) or
    // usernames (can be re-registered by someone else). Empty = anyone signed in.
    "ALLOWED_X_USERS": "",
    // X bills every API read to this app, whoever signed in. Fresh detailed
    // lookups per X account per day; "0" = unlimited.
    "DETAILED_DAILY_LIMIT": "25",
    "ARCHIVE_PAGES": "3",
    "TIMELINE_PAGES": "5",
    "REPLY_THREADS": "6"
  },
  // Only for an X app registered as a "Web App": wrangler secret put X_CLIENT_SECRET

  "observability": { "enabled": true }
}
